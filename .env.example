# One system user token per business portfolio.
# System user token with leads_retrieval. Pages in the SAME portfolio can be comma-separated.
# Page ids already found: 1050348698156106 and 312802658575239.
# Put each id on the portfolio that owns that Page.

META_ACCESS_TOKEN=
META_PAGE_ID=

META_ACCESS_TOKEN_2=
META_PAGE_ID_2=

# Optional. Leave empty to read every lead form on the page.
# Sample exports in this folder:
#   2281471209314213  Ortho Camapign Oct-copy
#   1558464462965880  Dentures OCT 2026
META_FORM_IDS=

# Optional case-insensitive name fragments. Empty means all campaigns / forms.
META_CAMPAIGN_FILTER=
META_FORM_FILTER=

# Graph API version. v25.0 is supported through July 2028.
META_GRAPH_VERSION=v25.0

# SQLite file. A postgres/mysql URL is not used by this server.
DATABASE_URL=sqlite:///./data/leads.db

# Local timer only. It does not run on Vercel, and it does not run in GitHub Actions.
# The daily job is .github/workflows/daily-sync.yml. On Vercel set this to 0.
SYNC_INTERVAL_MINUTES=60

# Used when a run continues from the last saved position. Leads read twice update their existing row.
SYNC_OVERLAP_MINUTES=120

# true:  the first sync reads SYNC_LOOKBACK_DAYS. Later daily runs read the previous UTC day.
# false: never reads SYNC_LOOKBACK_DAYS. The daily run reads the previous UTC day only.
#        The server also skips its startup sync.
SYNC_ON_START=true
SYNC_LOOKBACK_DAYS=90

HOST=127.0.0.1
PORT=8080

# Optional. When set, POST /sync requires header X-Api-Key.
SYNC_API_KEY=
